# Sigil 🦅 — Environment Variables
# Copy to .env and fill in your values

# === Deployment ===
NEXT_PUBLIC_APP_URL=http://localhost:3000
SENTRY_DSN=

# === AI Providers (multi-provider fallback chain) ===
VENICE_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# === Casper Network ===
CASPER_RPC_URL=https://rpc.testnet.casperlabs.io
CASPER_CHAIN_NAME=casper-testnet
CASPER_PRIVATE_KEY=

# === Cross-Chain Identity ===
CASPER_PUBLIC_KEY=
ETH_PRIVATE_KEY=

# === EAS (Ethereum Attestation Service) ===
EAS_BASE_SEPOLIA_CONTRACT=
EAS_ARCANIUM_CONTRACT=
EAS_AVALANCHE_FUJI_CONTRACT=

# === Database ===
DATABASE_URL=

# === Encryption (for legal document storage) ===
ENCRYPTION_KEY=

# === x402 ===
X402_FACILITATOR_URL=
X402_DEFAULT_AMOUNT=1000000000
